{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/scheduling",
      "destination": "/scheduling.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.idahoregenmed.com"
        }
      ],
      "destination": "https://idahoregenmed.com/:path*",
      "permanent": true
    },
    {
      "source": "/404",
      "destination": "/404.html"
    },
    {
      "source": "/cell-therapies",
      "destination": "/stem-cell-therapies",
      "permanent": true
    },
    {
      "source": "/cell-therapies.html",
      "destination": "/stem-cell-therapies",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/privacy-policy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/terms-of-service.html",
      "destination": "/terms",
      "permanent": true
    }
  ]
}
